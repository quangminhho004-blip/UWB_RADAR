# Upstream MobiVital: clone riêng lúc setup.
# KHÔNG redistribute vì repo họ không có LICENSE.
external/mobivital/

# Dữ liệu. Để trên Google Drive, không commit.
# Lưu ý: git KHÔNG cho chú thích cùng dòng với pattern, phải để riêng dòng.
data/*

# Trừ mã băm dữ liệu — nhỏ, và là bằng chứng dựng lại được đúng bộ dữ liệu.
!data/checksums.txt

# Kết quả chạy. Mỗi thực nghiệm một thư mục runs/<tên>/.
# Tệp nhỏ (điểm, bảng lựa chọn kênh, đường cong loss) VẪN commit để hội đồng
# xem được trên GitHub; chỉ chặn trọng số và tệp nén.
runs/**/*.pth
runs/*.zip
runs/*.tar.gz

# Định dạng dữ liệu và checkpoint
*.npz
*.npy
*.pth
*.pt
*.ckpt

# Thí nghiệm cũ, giữ ở máy không đưa lên GitHub
old_expreiment_outdated_donotuse/

# State của công cụ
.superpowers/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Notebook nháp để riêng, không đưa lên git: 424 KB output, trùng nội dung với
# notebooks/TN0.ipynb đã commit. Giữ trên máy để tra lại.
notebooks/tn0_reproduce.ipynb

# Bản nộp cuối: chỉ TN0 và TN1 bốn cấu hình. Sáu notebook dưới đây là toàn bộ
# bằng chứng chạy; notebook khác vẫn nằm ở máy nhưng không đưa lên git.
*.ipynb
!/notebooks/DATA_PREPARE.ipynb
!/notebooks/TN0.ipynb
!/notebooks/TN1_LSTM.ipynb
!/notebooks/TN1_LSTM_small.ipynb
!/notebooks/TN1_CNN_LSTM.ipynb
!/notebooks/TN1_DS_TCN_RF61_no_norm_do02_c64.ipynb
!/notebooks/TN2_ReceptiveField_DS_TCN_c64_4fold.ipynb
!/notebooks/TN2_ReceptiveField_DS_TCN_c64.ipynb
!/notebooks/TN3_HybridLoss_DS_TCN_c64.ipynb
!/notebooks/TN3_HybridLoss_DS_TCN_c64_rf121.ipynb
!/notebooks/TN4_final_test_ds_tcn_c64.ipynb
!/notebooks/TN4_final_test_ds_tcn_c64_rf121.ipynb

# Tài liệu giữ local để truy vết, không đưa vào bản nộp.
/.submission_archive/
# Kho của nhóm khác, nằm cùng thư mục làm việc — không phải của đồ án này.
/MobiVital_Submission/

# Checkpoint bản nộp — cho phép commit để chạy lại inference / đối chiếu.
!runs/tn1/**/*.pth
!runs/tn2_rf/**/*.pth
!runs/tn3/**/*.pth
!runs/tn4/**/*.pth

# Tài liệu đọc ở máy, không đưa lên nhánh nộp.
*.md
